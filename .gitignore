# KI Perspektiven – github.com/MarvinJakob/KIPerspektiven
# Das Repository ist öffentlich. Nichts einchecken, was Zugangsdaten, personenbezogene Daten oder
# lokale Arbeitsstände enthält. Zugangsdaten kommen lokal nur aus der Umgebungsvariable GH_TOKEN;
# Hetzner-Zugänge ausschließlich aus den GitHub-Secrets, siehe ARCHITECTURE.md.

# Archiv: alte Agenten-Vorgaben und Konzepte bleiben nur lokal und gelten nicht mehr (AGENTS.md).
# Nicht versioniert, damit sie in den Worktrees der Agenten gar nicht erst auftauchen.
/archive/

# Lokale Arbeitsordner mit Punkt-Präfix: Mocks und redaktionelle Inhalte (Textvorlagen, Recherchen,
# Präsentationen, Druckvorlagen) bleiben nur lokal.
/.mock/
/.content/

# Parallele Agenten: ein Git-Worktree pro Aufgabe (AGENTS.md, „Aufgabe übernehmen“)
/.worktrees/

# Lokale Einstellungen der Agenten-Werkzeuge
.claude/
.codex/
.cursor/

# Abhängigkeiten und Build-Artefakte
node_modules/
.build/
dist/
coverage/
tmp/
__pycache__/
*.py[cod]
*.exe
*.test
*.out

# Daten, Medien und Geheimnisse
statistics-ip.key
.token/
.ssh/
*.pem
*.key
.env
.env.*
!.env.example
*.db
*.db-wal
*.db-shm
# Laufzeitdaten der Anwendung (Standard DATABASE_PATH=data/app.db). Nur unter app/, damit
# andere Ordner namens data/ nicht erfasst werden.
/app/**/data/

# Logs
*.log
npm-debug.log*

# Editor und Betriebssystem
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Office-Temporärdateien (z. B. geöffnetes Word-Dokument)
~$*
.~lock.*
